<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="80"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:orientation="vertical"
        >
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            />
        <TextView
            android:id="@+id/option_alarm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/third_text_alarm"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/colorMaincolor"
            android:gravity="center_vertical|center"
            android:layout_weight="3"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            />
        <TextView
            android:id="@+id/option_logout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/third_text_logout"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/colorMaincolor"
            android:gravity="center_vertical|center"
            android:layout_weight="3"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            />
        <TextView
            android:id="@+id/option_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/third_text_password"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/colorMaincolor"
            android:gravity="center_vertical|center"
            android:layout_weight="3"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            />
        <TextView
            android:id="@+id/option_theme"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/third_text_theme"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/colorMaincolor"
            android:gravity="center_vertical|center"
            android:layout_weight="3"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            />
        <TextView
            android:id="@+id/option_update"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/third_text_update"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/colorMaincolor"
            android:gravity="center_vertical|center"
            android:layout_weight="3"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            />
        <TextView
            android:id="@+id/option_helper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/third_text_help"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/colorMaincolor"
            android:gravity="center_vertical|center"
            android:layout_weight="3"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"
            />


    </LinearLayout>

</LinearLayout>