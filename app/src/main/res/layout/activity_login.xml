<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor"
    android:id="@+id/login_main"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginTop="35dp"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="10"
            android:gravity="center_vertical|center"
            android:orientation="vertical"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="9"
                >
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="0.1"
                >
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/loginlogo"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="9"
                >
            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="10"
            android:orientation="vertical"

            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="horizontal"
                >
                <ImageView
                    android:id="@+id/IdImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/id"
                    android:layout_weight="10"
                    />

                <EditText
                    android:id="@+id/LoginID"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/edtunderline"
                    android:textColor="?attr/colorPrimaryDark"
                    android:layout_weight="1"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="horizontal"
                >
                <ImageView
                    android:id="@+id/PwImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/lock2"
                    android:layout_weight="11"
                    />

                <EditText
                    android:id="@+id/LoginPW"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/edtunderline"
                    android:textColor="?attr/colorPrimaryDark"
                    android:inputType="textPassword"

                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="horizontal"
                >
                <TextView
                    android:id="@+id/FindPw"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="right|center"
                    android:text="비밀번호를 잊어버리셨나요?"
                    android:textSize="16sp"
                    android:textColor="@color/colorMaincolor"
                    />

            </LinearLayout>



        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="10"
            android:orientation="vertical"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_weight="15"
                >

                <Button
                    android:id="@+id/LoginBT"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/loginbutton"
                    android:textColor="@color/colorWhite"
                    android:textSize="25sp"
                    android:text="로그인"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_weight="10"
                android:layout_marginTop="20dp"
                android:gravity="center"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:textColor="?attr/colorPrimaryDark"
                    android:text="가입한 아이디가 없다면?"
                    android:textSize="17sp"
                    />
                <TextView
                    android:id="@+id/CreateID"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="회원가입"
                    android:textSize="17sp"
                    android:textColor="@color/colorMaincolor"
                    />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="14"
                android:gravity="bottom|center"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THE BASE STERILIZER"
                    android:textColor="?attr/colorPrimaryDark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"
                    />
            </LinearLayout>




        </LinearLayout>

    </LinearLayout>
</LinearLayout>
