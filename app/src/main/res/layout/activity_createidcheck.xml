<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="400dp"
    android:background="@drawable/idcreatpagebg"
    android:id="@+id/createidcheck_main"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center|center_horizontal|center_vertical"
        android:background="@drawable/idcreatpagebn"
        android:textSize="20dp"
        android:text="이용약관"
        android:textStyle="bold"
        android:layout_weight="21.9"
        android:textColor="@color/colorWhite"
        />
    <ScrollView
        android:id="@+id/createidchecknextsv_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:layout_margin="10dp"
        android:scrollbars="none"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="left|center"

                android:text="서비스 이용약관"
                android:textSize="17dp"
                android:textStyle="bold"
                />

            <ScrollView
                android:id="@+id/createidchecknextsv_s01"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:scrollbarSize="2dp"
                android:scrollbarThumbVertical="@color/colorMaincolor">

                <TextView
                    android:id="@+id/termsTv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textSize="13dp" />

            </ScrollView>

            <CheckBox
                android:id="@+id/createidcheck01"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:textSize="13dp"
                android:textStyle="bold"
                android:text="동의합니다"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="left|center"
                android:text="개인정보 수집 및 이용안내"
                android:textSize="17dp"
                android:textStyle="bold"
                />
            <ScrollView
                android:id="@+id/createidchecknextsv_s02"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:scrollbarThumbVertical="@color/colorMaincolor"
                android:scrollbarSize="2dp"
                >
                <TextView
                    android:id="@+id/privacyTv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textSize="13dp"

                    />

            </ScrollView>

            <CheckBox
                android:id="@+id/createidcheck02"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:text="동의합니다"
                android:textSize="13dp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="15dp"
                />
            <Button
                android:id="@+id/createidchecknext"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="다음"
                android:textSize="15dp"
                android:background="@drawable/loginbutton"
                android:textColor="@color/colorWhite"
                android:layout_marginBottom="15dp"
                />

        </LinearLayout>
    </ScrollView>
</LinearLayout>