<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="400dp"
    android:background="@drawable/idcreatpagebg"
    android:id="@+id/permission_main"
    android:orientation="vertical"

    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center|center_horizontal|center_vertical"
        android:background="@drawable/idcreatpagebn"
        android:textSize="20sp"
        android:text="권한 수락"
        android:layout_weight="10.7"
        android:textStyle="bold"
        android:textColor="@color/colorWhite"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_margin="10dp"
        android:layout_weight="3"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="저장소 읽기,쓰기"
            android:textSize="17sp"
            android:textStyle="bold"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="기기로 부터 사진을 전송받아 핸드폰 저장소로 저장하는 서비스를 제공하는데 필요합니다."
            android:layout_marginTop="5sp"
            />

    </LinearLayout>
    <Button
        android:id="@+id/permission_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="5sp"
        android:layout_weight="0"
        android:text="동의 후 수락"
        />

</LinearLayout>